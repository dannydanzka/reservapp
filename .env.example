# ==========================================
# 📱 RESERVAPP MOBILE - ENVIRONMENT VARIABLES  
# ==========================================
#
# Copy this file to .env for local development:
# cp .env.example .env
#
# ⚠️  NEVER commit .env to git (already in .gitignore)
#

# ==========================================
# 🌐 API CONFIGURATION (Required)
# ==========================================

# Backend API Base URL
REACT_APP_API_BASE_URL=

# API Settings
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3

# ==========================================
# 🛠️ DEVELOPMENT ENVIRONMENT
# ==========================================

# Environment mode
NODE_ENV=development

# Debug settings
DEBUG=true
REACT_APP_ENABLE_CONSOLE_LOGS=true
REACT_APP_ENABLE_DEV_MENU=true

# Redux debugging
REACT_APP_REDUX_LOGGER=true
REACT_APP_REDUX_DEVTOOLS=true

# ==========================================
# 📱 APP CONFIGURATION
# ==========================================

# App information
REACT_APP_APP_NAME=ReservApp
REACT_APP_VERSION=1.0.0
REACT_APP_BUILD_NUMBER=1

# Bundle identifiers
REACT_APP_BUNDLE_ID_IOS=com.reservapp.mobile
REACT_APP_PACKAGE_NAME_ANDROID=com.reservapp.mobile

# ==========================================
# 🎨 UI/UX SETTINGS (Optional)
# ==========================================

# Default settings
REACT_APP_DEFAULT_LANGUAGE=es
REACT_APP_DEFAULT_THEME=system
REACT_APP_DEFAULT_FONT_SCALE=medium

# Features
REACT_APP_ENABLE_BIOMETRIC_AUTH=false
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true

# ==========================================
# 📊 ANALYTICS & MONITORING (Optional)
# ==========================================

# Error tracking
REACT_APP_SENTRY_DSN=

# Firebase configuration
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=

# Analytics
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_CRASHLYTICS_ENABLED=false

# ==========================================
# 🔒 SECURITY (Production Only)
# ==========================================

# Security features
REACT_APP_CERTIFICATE_PINNING=false
REACT_APP_SECURITY_AUDIT_ENABLED=false

# ==========================================
# 🚀 CI/CD & DEPLOYMENT VARIABLES
# ==========================================

# Apple Developer Account
FASTLANE_USER=
FASTLANE_PASSWORD=
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
DEVELOPER_TEAM_ID=
APP_STORE_CONNECT_TEAM_ID=

# App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_CONTENT=

# Code Signing (iOS)
MATCH_PASSWORD=
MATCH_GIT_URL=
MATCH_GIT_BASIC_AUTHORIZATION=

# Android Signing
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
ANDROID_KEYSTORE_BASE64=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_TRACK=internal

# Build Notifications
SLACK_WEBHOOK_URL=

# Deployment Settings
AUTO_DEPLOY_TO_TESTFLIGHT=false
AUTO_DEPLOY_TO_PLAY_STORE=false
DEFAULT_VERSION_INCREMENT=patch
BUILD_NUMBER_STRATEGY=timestamp

# ==========================================
# 📝 DEVELOPMENT NOTES
# ==========================================
#
# For local development, fill in REACT_APP_API_BASE_URL with your API endpoint
# All other variables are optional for basic development
#